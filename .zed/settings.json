{
	"tab_size": 2,
	"hard_tabs": true,
	"formatter": "language_server",
	"languages": {
		"Svelte": {
			"language_servers": ["svelte-language-server", "!typescript-language-server", "..."],
			"formatter": {
				"external": {
					"command": "bunx",
					"arguments": ["prettier", "--stdin-filepath", "{buffer_path}"]
				}
			}
		},
		"TypeScript": {
			"formatter": {
				"external": {
					"command": "bunx",
					"arguments": ["prettier", "--stdin-filepath", "{buffer_path}"]
				}
			}
		}
	}
}
