{
	"name": "kitchen-gremlin",
	"private": true,
	"type": "module",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev": "bun run --cwd apps/web dev",
		"build": "bun run --cwd apps/web build",
		"typecheck": "bun run --cwd apps/web check && tsc --noEmit -p packages/schema/tsconfig.json && tsc --noEmit -p packages/importers/tsconfig.json",
		"test": "vitest run",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@types/bun": "latest",
		"eslint": "^9.0.0",
		"eslint-plugin-svelte": "^2.46.0",
		"globals": "^15.0.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.0.0",
		"vitest": "^2.1.0"
	}
}
