{
	"name": "kitchen-gremlin",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev": "bun run --cwd apps/web dev",
		"build": "bun run --cwd apps/web build",
		"typecheck": "bun run --cwd apps/web check && tsc -b packages/schema packages/importers",
		"test": "vitest run",
		"lint": "eslint ."
	},
	"devDependencies": {
		"eslint": "^9.0.0",
		"typescript": "^5.7.0",
		"vitest": "^2.1.0"
	}
}
